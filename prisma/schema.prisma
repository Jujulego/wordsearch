generator client {
  provider = "prisma-client"
  output   = "../lib/prisma"
}

datasource db {
  provider = "postgresql"
}

model Word {
  word      String @id
  frequency Float

  @@index([word(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Seed {
  id       String   @id
  seededAt DateTime @default(now())
}
